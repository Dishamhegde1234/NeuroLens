# Copy to .env and fill in. Never commit .env.

# Required for anything shared or deployed. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLite file location (default: instance/neurolens.db)
# DATABASE_PATH=instance/neurolens.db

# "heuristic" (default) or "ml" (needs: pip install -r requirements-ml.txt && python train_model.py)
RISK_ENGINE=heuristic

# Set to 1 when served over HTTPS
# SESSION_COOKIE_SECURE=1

# Optional "Explain with AI" button. Set ONE of these. Gemini is used if both are set.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
